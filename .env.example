# ============================================
# LDMNS – Lügen darf man nicht sagen
# Kopiere diese Datei zu .env und füll die Werte aus
# Die .env wird NICHT ins Git eingecheckt (.gitignore)
# ============================================

# Frontend URL (wo die React-App läuft)
FRONTEND_URL=http://localhost:5173

# Backend URL (für das Frontend)
VITE_BACKEND_URL=http://localhost:3001

# Twitch OAuth
# App anlegen unter: https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/api/auth/twitch/callback

# Admin-Passwort fürs Admin-Panel
ADMIN_SECRET=

PORT=3001
